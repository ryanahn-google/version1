# Pre-commit hook enforcing formatting, linting, type checking, and tests.
set -euo pipefail

export UV_DEFAULT_INDEX="https://pypi.org/simple"
export UV_INDEX_URL="https://pypi.org/simple"

echo "============================================================"
echo "🔍 Running pre-commit validation: format, lint, typecheck, tests..."
echo "============================================================"

# 1. Lockfile Consistency Check
echo "▶ [1/5] Checking uv.lock consistency with pyproject.toml..."
if ! uv lock --check; then
    echo "❌ uv.lock is out of sync with pyproject.toml! Run 'uv lock' to update."
    exit 1
fi

# 2. Format Check
echo "▶ [2/5] Checking code formatting (ruff format)..."
if ! uv run ruff format --check .; then
    echo "❌ Code formatting check failed! Run 'make format' to format code."
    exit 1
fi

# 3. Linting & Spelling Check
echo "▶ [3/5] Checking linter & spellings (ruff check, codespell)..."
if ! uv run ruff check . || ! uv run codespell; then
    echo "❌ Linting check failed! Fix the reported errors above."
    exit 1
fi

# 3. Type Checking
echo "▶ [3/4] Running frontend type checking (tsc --noEmit)..."
if ! (cd frontend && npm run typecheck); then
    echo "❌ Type check failed! Fix type errors before committing."
    exit 1
fi

# 4. Tests
echo "▶ [4/4] Running test suite (pytest)..."
if ! uv run pytest tests/unit tests/integration; then
    echo "❌ Tests failed! Ensure all tests pass before committing."
    exit 1
fi

echo "============================================================"
echo "✅ All pre-commit checks passed successfully! Proceeding with commit."
echo "============================================================"
exit 0
