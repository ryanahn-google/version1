# ==============================================================================
# Marketing Value Creator (MVC) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values for your local or deployment environment:
#   cp .env.example .env
#
# NOTE: All variables below are managed and validated via Pydantic BaseSettings
# in `app/settings.py`. Default values allow the application to run locally out-of-the-box,
# but configuring these variables is essential for staging/production deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Identity Settings (ApplicationSettings)
# ------------------------------------------------------------------------------
# Base URL where the FastAPI backend and SPA are served
APP_URL=http://0.0.0.0:8000

# Semantic version of the agent service
AGENT_VERSION=0.1.0

# Set to "true" during CI/automated test suites to bypass remote LLM calls
INTEGRATION_TEST=false

# Default or fallback user identifier for campaign sessions (e.g. test user or service ID)
USER_ID=

# Cloud Run service name (automatically populated by Google Cloud Run runtime)
# K_SERVICE=mvc-orchestrator


# ------------------------------------------------------------------------------
# 2. Security, Authentication & Guardrails (SecuritySettings)
# ------------------------------------------------------------------------------
# Deployment environment: "development", "staging", or "production"
ENV=development

# Google OAuth 2.0 Client ID for frontend OIDC authentication & ID token verification
GOOGLE_OAUTH_CLIENT_ID=

# Google Cloud Model Armor template resource path for zero-trust prompt & payload guardrails
# Format: projects/{PROJECT_ID}/locations/us/templates/{TEMPLATE_NAME}
MODEL_ARMOR_TEMPLATE=

# Browser session cookie name for authenticated user sessions
SESSION_COOKIE_NAME=mvc_session

# Browser session expiration duration in days
SESSION_EXPIRE_DAYS=7

# Optional OIDC bearer ID token for manual CLI/cURL testing
# ID_TOKEN=


# ------------------------------------------------------------------------------
# 3. Google Cloud Platform & Agent Platform (GoogleCloudSettings)
# ------------------------------------------------------------------------------
# Target Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=capstone-staging-506811

# Resource region for Vertex AI and regional resources
# Note: Foundation model API endpoints are pinned to "global" per ADR-0002
GOOGLE_CLOUD_LOCATION=global

# Enable Agent Platform Enterprise mode (uses Vertex AI backend instead of Gemini Developer API)
GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_GENAI_USE_VERTEXAI=true # Backward-compatible alias

# Optional Google AI Studio API key (only used if GOOGLE_GENAI_USE_ENTERPRISE is false)
# GEMINI_API_KEY=your-gemini-api-key-here

# Foundation Models (ADR-0002 Topology)
# - Orchestrator: Gemini 3.1 Pro
ORCHESTRATOR_MODEL=gemini-3.1-pro-preview
ORCHESTRATOR_FALLBACK_MODEL=gemini-2.5-pro

# - Structured Subagents (P1, P2, P4): Gemini 3.5 Flash Lite
SUB_AGENT_MODEL=gemini-3.5-flash-lite
SUB_AGENT_FALLBACK_MODEL=gemini-2.5-flash

# - Creative Visual Generation (P3b): Nano Banana 2 Lite
IMAGE_MODEL=gemini-3.1-flash-lite-image

# Service Account Email used for signing Cloud Storage V4 URLs and IAM attestation
SERVICE_ACCOUNT_EMAIL=

# Client certificate enforcement flags for VPC-SC / mTLS environments
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
CLOUDSDK_CONTEXT_AWARE_USE_CLIENT_CERTIFICATE=false


# ------------------------------------------------------------------------------
# 4. A2A (Agent-to-Agent) Ingress Endpoints (A2AClientSettings)
# ------------------------------------------------------------------------------
# JSON-RPC 2.0 endpoints for remote P1-P4 subagents deployed to Agent Platform Agent Runtime.
# When left empty, the Orchestrator falls back to in-process execution (ADR-0003).
# Format: https://{REGION}-aiplatform.googleapis.com/reasoningEngines/v1/projects/{PROJ_NUM}/locations/{REGION}/reasoningEngines/{ENGINE_ID}/api/a2a/{AGENT_NAME}
A2A_P1_URL=
A2A_P2_URL=
A2A_P3_URL=
A2A_P4_URL=


# ------------------------------------------------------------------------------
# 5. Database & Session Persistence (DatabaseSettings)
# ------------------------------------------------------------------------------
# Local Development: Path to SQLite database file
LOCAL_DB_PATH=campaign_sessions.db

# Production / Cloud Run: Cloud SQL instance connection name and credentials
# INSTANCE_CONNECTION_NAME=capstone-staging-506811:asia-northeast3:version1-db-staging
# DB_USER=version1
# DB_PASS=your-database-password
# DB_NAME=version1

# Alternatively, direct PostgreSQL connection URL (e.g. for local Postgres container)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campaigns
# DB_HOST=localhost
# DB_PORT=5432


# ------------------------------------------------------------------------------
# 6. Artifact & Storage Settings (StorageSettings)
# ------------------------------------------------------------------------------
# Google Cloud Storage bucket for generated campaign visual deliverables and drafts
ARTIFACTS_BUCKET_NAME=capstone-staging-506811-version1-artifacts

# Fallback/Telemetry bucket for prompt-response logging and raw completions
LOGS_BUCKET_NAME=capstone-staging-506811-version1-logs


# ------------------------------------------------------------------------------
# 7. Telemetry, OpenTelemetry & Cloud Trace (TelemetrySettings)
# ------------------------------------------------------------------------------
# Export distributed traces to Google Cloud Trace (Console > Trace > Trace explorer)
OTEL_TO_CLOUD=true
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Service name displayed in Cloud Trace spans
OTEL_SERVICE_NAME=mvc-orchestrator

# OpenTelemetry GenAI Semantic Conventions opt-in
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Message content capture in traces and logs:
# Options: "NO_CONTENT", "EVENT_ONLY" (Cloud Logging only), "SPAN_ONLY", "SPAN_AND_EVENT"
# Default is EVENT_ONLY / false to prevent sensitive data leakage into trace spans.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Full Prompt-Response Logging to Cloud Storage & BigQuery
OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://capstone-staging-506811-version1-logs/completions
